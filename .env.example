# ==============================================================================
# 1. Gemini API Configuration (Required for Agent Synthesis & Search Grounding)
# ==============================================================================
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# 2. Agent Learning Preferences
# ==============================================================================
# Comma-separated list of focus areas to prioritize in your learning digest
LEARNING_FOCUS_TOPICS=LLMs, AI Agents, RAG, Multimodal AI, Reasoning Models, Post-Training & RLHF, Inference Optimization
LOOKBACK_DAYS=2
MAX_ITEMS_PER_SOURCE=10
DIGEST_OUTPUT_DIR=digests

# ==============================================================================
# 3. Telegram Notification Settings (Optional)
# ==============================================================================
# Create a bot via @BotFather on Telegram to get TELEGRAM_BOT_TOKEN
# Get your TELEGRAM_CHAT_ID via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# 4. Email Notification Settings (Optional - supports SMTP or Resend API)
# ==============================================================================
EMAIL_ENABLED=false
# Provider: "smtp" (e.g., Gmail App Password) or "resend"
EMAIL_PROVIDER=smtp

# --- Option A: SMTP (Gmail, Outlook, Custom SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# --- Option B: Resend API (https://resend.com) ---
RESEND_API_KEY=
